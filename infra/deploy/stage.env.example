# Docker Hub username that owns the two application image repositories
DOCKERHUB_USER=your-dockerhub-username

# The development branch publishes this tag; use a release tag to pin staging.
IMAGE_TAG=latest
WEB_PORT=8080

POSTGRES_DB=engineering_knowledge
POSTGRES_USER=eka_app
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password

MINIO_ROOT_USER=eka_minio_admin
MINIO_ROOT_PASSWORD=replace-with-another-strong-password
S3_BUCKET=engineering-documents
S3_REGION=us-east-1
