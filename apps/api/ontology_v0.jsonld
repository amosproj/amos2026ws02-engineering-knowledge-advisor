{
  "@context": {
    "og": "https://example.org/ograg/ontology#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/",
    "domain": {"@id": "rdfs:domain", "@type": "@id"},
    "range": {"@id": "rdfs:range", "@type": "@id"},
    "displayName": "rdfs:label",
    "comment": "rdfs:comment",
    "enum": "og:allowedValues"
  },
  "@graph": [
    {"@id": "og:Machine", "@type": "rdfs:Class", "displayName": "Machine", "comment": "A special-purpose machine or line, e.g. a robot cell. Stored as a record.", "og:record": true},
    {"@id": "og:MachineProperties", "@type": "rdfs:Class", "displayName": "Machine properties", "comment": "Further properties of a machine."},
    {"@id": "og:AssemblyGroup", "@type": "rdfs:Class", "displayName": "Assembly group", "comment": "Anchor entity. A mechanical assembly group (Baugruppe) of a machine, which may contain further assembly groups; search results group by it. Stored as a record.", "og:record": true, "og:anchor": true},
    {"@id": "og:AssemblyProperties", "@type": "rdfs:Class", "displayName": "Assembly group properties", "comment": "Further properties of an assembly group."},
    {"@id": "og:CadFile", "@type": "rdfs:Class", "displayName": "CAD file", "comment": "The CAD model of a machine. Stored as a record, the file itself lives in object storage.", "og:record": true, "og:file": true},
    {"@id": "og:KnowledgeItem", "@type": "rdfs:Class", "displayName": "Knowledge item", "comment": "One piece of engineering knowledge about specific machines or assembly groups: a requirement, consideration, design decision or lesson learned. Stored as a record and extracted from documents.", "og:record": true, "og:extractable": true},
    {"@id": "og:KnowledgeProperties", "@type": "rdfs:Class", "displayName": "Knowledge item properties", "comment": "The content of a knowledge item."},
    {"@id": "og:Guideline", "@type": "rdfs:Class", "displayName": "Guideline", "comment": "A general rule for every machine, e.g. a global requirement. Checked against every answer instead of answering. Stored as a record and extracted from documents.", "og:record": true, "og:extractable": true, "og:guideline": true},

    {"@id": "og:identifier", "@type": "rdf:Property", "domain": ["og:Machine", "og:AssemblyGroup"], "range": "schema:Text", "displayName": "identifier", "comment": "Identifier, e.g. the project or serial number of a machine. An assembly group's stays the same when the same CAD file is imported again.", "og:identity": true, "og:search": ["semantic", "lexical"]},
    {"@id": "og:name", "@type": "rdf:Property", "domain": ["og:Machine", "og:AssemblyGroup"], "range": "schema:Text", "displayName": "name", "comment": "Name of the machine or assembly group.", "og:identity": true},
    {"@id": "og:description", "@type": "rdf:Property", "domain": ["og:Machine", "og:AssemblyGroup"], "range": "schema:Text", "displayName": "description", "comment": "Free-text description of the machine or assembly group."},
    {"@id": "og:customer", "@type": "rdf:Property", "domain": "og:Machine", "range": "schema:Text", "displayName": "customer", "comment": "The customer the machine was built for."},
    {"@id": "og:properties", "@type": "rdf:Property", "domain": "og:Machine", "range": "og:MachineProperties", "displayName": "properties", "comment": "Further properties of the machine."},

    {"@id": "og:size", "@type": "rdf:Property", "domain": "og:MachineProperties", "range": "schema:Number", "displayName": "size", "comment": "Size of the machine."},

    {"@id": "og:properties", "@type": "rdf:Property", "domain": "og:AssemblyGroup", "range": "og:AssemblyProperties", "displayName": "properties", "comment": "Further properties of the assembly group."},
    {"@id": "og:rootOf", "@type": "rdf:Property", "domain": "og:AssemblyGroup", "range": "og:Machine", "displayName": "root of", "comment": "The machine whose top assembly group this is.", "og:edgeType": "parent", "og:deleteWithParent": true},
    {"@id": "og:partOf", "@type": "rdf:Property", "domain": "og:AssemblyGroup", "range": "og:AssemblyGroup", "displayName": "part of", "comment": "The assembly group this one belongs to.", "og:edgeType": "parent", "og:deleteWithParent": true},

    {"@id": "og:path", "@type": "rdf:Property", "domain": "og:AssemblyProperties", "range": "schema:Text", "displayName": "path", "comment": "Path of the assembly group, e.g. in the CAD assembly tree.", "og:search": ["lexical"]},
    {"@id": "og:dimensions", "@type": "rdf:Property", "domain": "og:AssemblyProperties", "range": "schema:Number", "displayName": "dimensions", "comment": "Dimensions of the assembly group."},

    {"@id": "og:name", "@type": "rdf:Property", "domain": "og:CadFile", "range": "schema:Text", "displayName": "name", "comment": "File name, e.g. RC-01.step.", "og:search": ["semantic", "lexical"]},
    {"@id": "og:format", "@type": "rdf:Property", "domain": "og:CadFile", "range": "schema:Text", "displayName": "format", "comment": "CAD system or file format, e.g. STEP or CATIA V5."},
    {"@id": "og:uri", "@type": "rdf:Property", "domain": "og:CadFile", "range": "schema:URL", "displayName": "uri", "comment": "Where the original file can be found.", "og:search": ["lexical"]},
    {"@id": "og:timestamp", "@type": "rdf:Property", "domain": "og:CadFile", "range": "schema:DateTime", "displayName": "timestamp", "comment": "When the CAD file was created or exported."},
    {"@id": "og:partOf", "@type": "rdf:Property", "domain": "og:CadFile", "range": "og:Machine", "displayName": "part of", "comment": "The machine the CAD file belongs to. A machine has one CAD file.", "og:edgeType": "parent", "og:deleteWithParent": true, "og:maxPerParent": 1},

    {"@id": "og:itemType", "@type": "rdf:Property", "domain": "og:KnowledgeItem", "range": "schema:Text", "displayName": "item type", "enum": ["requirement", "consideration", "design decision", "lesson learned"], "comment": "The kind of knowledge. Searched by meaning: together with a group's name in the request it brings that group's items of this kind forward.", "og:search": ["semantic"]},
    {"@id": "og:sourceDocumentId", "@type": "rdf:Property", "domain": ["og:KnowledgeItem", "og:Guideline"], "range": "schema:Text", "displayName": "source document", "comment": "Id of the uploaded document the record was extracted from, e.g. a walkthrough transcript. Filled by the extraction.", "og:search": ["semantic", "lexical"], "og:provenance": true},
    {"@id": "og:reference", "@type": "rdf:Property", "domain": ["og:KnowledgeItem", "og:Guideline"], "range": "schema:Text", "displayName": "reference", "comment": "A standard, norm or other reference the record is based on, e.g. DIN EN ISO 13849.", "og:search": ["semantic", "lexical"]},
    {"@id": "og:properties", "@type": "rdf:Property", "domain": "og:KnowledgeItem", "range": "og:KnowledgeProperties", "displayName": "properties", "comment": "The content of the knowledge item."},
    {"@id": "og:appliesTo", "@type": "rdf:Property", "domain": "og:KnowledgeItem", "range": "og:AssemblyGroup", "displayName": "applies to", "comment": "The assembly groups the item is about.", "og:edgeType": "parent"},
    {"@id": "og:appliesToMachine", "@type": "rdf:Property", "domain": "og:KnowledgeItem", "range": "og:Machine", "displayName": "applies to machine", "comment": "The machines the item is about, when it concerns a whole machine.", "og:edgeType": "parent"},

    {"@id": "og:name", "@type": "rdf:Property", "domain": "og:KnowledgeProperties", "range": "schema:Text", "displayName": "name", "comment": "Short name of the item."},
    {"@id": "og:statement", "@type": "rdf:Property", "domain": "og:KnowledgeProperties", "range": "schema:Text", "displayName": "statement", "comment": "The knowledge in one or two sentences, as the engineer said it."},
    {"@id": "og:reasoning", "@type": "rdf:Property", "domain": "og:KnowledgeProperties", "range": "schema:Text", "displayName": "reasoning", "comment": "Why the statement holds: the engineering reasoning behind it."},
    {"@id": "og:condition", "@type": "rdf:Property", "domain": "og:KnowledgeProperties", "range": "schema:Text", "displayName": "condition", "comment": "When the item applies, e.g. a part size or an operating case."},
    {"@id": "og:consequence", "@type": "rdf:Property", "domain": "og:KnowledgeProperties", "range": "schema:Text", "displayName": "consequence", "comment": "What happens when the item is ignored."},
    {"@id": "og:recommendation", "@type": "rdf:Property", "domain": "og:KnowledgeProperties", "range": "schema:Text", "displayName": "recommendation", "comment": "What to do, according to the item."},
    {"@id": "og:confidence", "@type": "rdf:Property", "domain": "og:KnowledgeProperties", "range": "schema:Text", "displayName": "confidence", "comment": "How well established the knowledge is.", "enum": ["established practice", "rule of thumb", "unverified"], "og:search": ["semantic"]},

    {"@id": "og:description", "@type": "rdf:Property", "domain": "og:Guideline", "range": "schema:Text", "displayName": "description", "comment": "The guideline in its own words, e.g. 'Above 3 m width, transport becomes very expensive.'"}
  ]
}
