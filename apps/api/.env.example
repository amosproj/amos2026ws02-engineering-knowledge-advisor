# this .env applies only if backend is run from repo root with:
#   uv run --directory apps/api uvicorn main:app
# or directly run from inside apps/api/ directory
# running it with --project instead of --directory will use the root .env

API_PROFILE=dev

API_OGRAG_ONTOLOGY_PATH=ontology_v0.jsonld

API_S3_ENDPOINT_URL=http://localhost:9000
API_S3_BUCKET=engineering-documents
API_S3_ACCESS_KEY=eka_minio_admin
API_S3_SECRET_KEY=change_me_to_another_long_random_password
API_S3_REGION=us-east-1
API_S3_PUBLIC_URL=/storage
