# this .env applies only if backend is run from repo root with:
#   uv run --directory apps/api uvicorn main:app
# or directly run from inside apps/api/ directory
# running it with --project instead of --directory will use the root .env

API_PROFILE=dev

API_OGRAG_ONTOLOGY_PATH=ontology_v0.jsonld

API_S3_ENDPOINT_URL=http://localhost:9000
API_S3_BUCKET=engineering-documents
API_S3_ACCESS_KEY=eka_minio_admin
API_S3_SECRET_KEY=change_me_to_another_long_random_password
API_S3_REGION=us-east-1
API_S3_PUBLIC_URL=/storage

# LLM providers are disabled unless explicitly enabled. Set provider API keys
# only in a local .env file or deployment secret store, never in source control.
# API_LLM_DEFAULT_PROVIDER=openai
# API_LLM_OPENAI__ENABLED=true
# API_LLM_OPENAI__API_KEY=replace_with_secret
# API_LLM_OPENAI__DEFAULT_MODEL=gpt-4o-mini
# API_LLM_OPENAI__TIMEOUT_SECONDS=60
# API_LLM_ANTHROPIC__ENABLED=true
# API_LLM_ANTHROPIC__API_KEY=replace_with_secret
# API_LLM_ANTHROPIC__DEFAULT_MODEL=claude-3-5-sonnet-20241022
# API_LLM_GOOGLE__ENABLED=true
# API_LLM_GOOGLE__API_KEY=replace_with_secret
# API_LLM_GOOGLE__DEFAULT_MODEL=gemini-2.0-flash
# API_LLM_MISTRAL__ENABLED=true
# API_LLM_MISTRAL__API_KEY=replace_with_secret
# API_LLM_MISTRAL__DEFAULT_MODEL=mistral-small-latest
# API_LLM_OLLAMA__ENABLED=true
# When the API runs in Docker and Ollama runs on Windows/macOS host:
# API_LLM_OLLAMA__BASE_URL=http://host.docker.internal:11434
# API_LLM_OLLAMA__DEFAULT_MODEL=llama3.2
# API_LLM_AZURE_OPENAI__ENABLED=true
# API_LLM_AZURE_OPENAI__API_KEY=replace_with_secret
# API_LLM_AZURE_OPENAI__BASE_URL=https://resource.openai.azure.com
# API_LLM_AZURE_OPENAI__DEFAULT_MODEL=deployment-name
# Hetzner Inference is experimental; availability is not guaranteed.
# API_LLM_HETZNER__ENABLED=true
# API_LLM_HETZNER__API_KEY=replace_with_secret
# API_LLM_HETZNER__DEFAULT_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
