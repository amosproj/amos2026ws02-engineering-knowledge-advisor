{
  "openapi": "3.1.0",
  "info": {
    "title": "Engineering Knowledge Advisor API",
    "version": "0.2.1"
  },
  "paths": {
    "/api/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Confirm that the API process is running.",
        "operationId": "health_api_health_live_get",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response 200 Health Api Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/records": {
      "post": {
        "tags": [
          "v1",
          "records"
        ],
        "summary": "Post Record",
        "description": "Creates a record with a generated id. Links hold target ids.\n\n``@type`` defaults to anchor class. A sent ``@id`` is ignored.",
        "operationId": "post_record_api_v1_records_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordNode"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new record's id including validation drops.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordWritten"
                }
              }
            }
          },
          "422": {
            "description": "Does not fit ontology. Link target is missing, or value cannot be stored.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Concurrent write. Please try again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "v1",
          "records"
        ],
        "summary": "Get Records",
        "description": "All validated records by id. WARNING: reads EVERY record.",
        "operationId": "get_records_api_v1_records_get",
        "parameters": [
          {
            "name": "cls",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only records of this class.",
              "title": "Cls"
            },
            "description": "Only records of this class."
          },
          {
            "name": "parentId",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only records with a parent link to this parent id.",
              "title": "Parentid"
            },
            "description": "Only records with a parent link to this parent id."
          },
          {
            "name": "include",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(status|children|upload)(,(status|children|upload))*$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated extras per record.",
              "title": "Include"
            },
            "description": "Comma-separated extras per record."
          }
        ],
        "responses": {
          "200": {
            "description": "All records sorted by their id.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Records"
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/RecordView"
                      }
                    }
                  ],
                  "title": "Response Get Records Api V1 Records Get"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/records/{recordId}": {
      "put": {
        "tags": [
          "v1",
          "records"
        ],
        "summary": "Put Record",
        "description": "PUTs a record. Links hold target ids.\n\n``@type`` defaults to anchor class.\n``@id`` is ``record_id``.\nLink targets must already exist.",
        "operationId": "put_record_api_v1_records__recordId__put",
        "parameters": [
          {
            "name": "recordId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "title": "Recordid"
            }
          },
          {
            "name": "if-match",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Record version last read, e.g. \"1234\". Without it, nothing is checked.",
              "title": "If-Match"
            },
            "description": "Record version last read, e.g. \"1234\". Without it, nothing is checked."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordNode"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully stored record including validation drops.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordWritten"
                }
              }
            }
          },
          "422": {
            "description": "Does not fit ontology. Link target is missing, or value cannot be stored.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Concurrent write. Please try again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "412": {
            "description": "Record changed since the If-Match version. Read it again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "v1",
          "records"
        ],
        "summary": "Patch Record",
        "description": "Executes JSON Merge Patch (https://www.rfc-editor.org/info/rfc7396/).\nWhole record is validated again as with PUT.",
        "operationId": "patch_record_api_v1_records__recordId__patch",
        "parameters": [
          {
            "name": "recordId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "title": "Recordid"
            }
          },
          {
            "name": "if-match",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Record version last read, e.g. \"1234\". Without it, nothing is checked.",
              "title": "If-Match"
            },
            "description": "Record version last read, e.g. \"1234\". Without it, nothing is checked."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordChanges"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully changed record including validation drops.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordWritten"
                }
              }
            }
          },
          "404": {
            "description": "No such record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Does not fit ontology. Link target is missing, or value cannot be stored.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Concurrent write. Please try again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "412": {
            "description": "Record changed since the If-Match version. Read it again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "v1",
          "records"
        ],
        "summary": "Get Record",
        "description": "Returns validated record. Links hold target ids.",
        "operationId": "get_record_api_v1_records__recordId__get",
        "parameters": [
          {
            "name": "recordId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "title": "Recordid"
            }
          },
          {
            "name": "include",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(status|children|upload)(,(status|children|upload))*$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated extras per record.",
              "title": "Include"
            },
            "description": "Comma-separated extras per record."
          }
        ],
        "responses": {
          "200": {
            "description": "Requested record.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/RecordNode"
                    },
                    {
                      "$ref": "#/components/schemas/RecordView"
                    }
                  ],
                  "title": "Response Get Record Api V1 Records  Recordid  Get"
                }
              }
            }
          },
          "404": {
            "description": "No such record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "v1",
          "records"
        ],
        "summary": "Delete Record",
        "description": "Deletes a record and unlinks it everywhere.\n\nRecords left without a parent link are also deleted if ``delete_orphans`` is ``True``, otherwise marked for review.\nRecords whose parent link is marked ``og:deleteWithParent`` are deleted with it.",
        "operationId": "delete_record_api_v1_records__recordId__delete",
        "parameters": [
          {
            "name": "recordId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "title": "Recordid"
            }
          },
          {
            "name": "deleteOrphans",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Deleteorphans"
            }
          },
          {
            "name": "if-match",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Record version last read, e.g. \"1234\". Without it, nothing is checked.",
              "title": "If-Match"
            },
            "description": "Record version last read, e.g. \"1234\". Without it, nothing is checked."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully deleted record including record ids marked for review.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordsDeleted"
                }
              }
            }
          },
          "409": {
            "description": "Concurrent write, or a file of the record is being processed. Please try again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "412": {
            "description": "Record changed since the If-Match version. Read it again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/records/review": {
      "get": {
        "tags": [
          "v1",
          "records"
        ],
        "summary": "Get Records To Review",
        "description": "Returns knowledge items whose assembly group was deleted.",
        "operationId": "get_records_to_review_api_v1_records_review_get",
        "responses": {
          "200": {
            "description": "Records marked for manual user review.",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RecordToReview"
                  },
                  "type": "array",
                  "title": "Response 200 Get Records To Review Api V1 Records Review Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/records/{recordId}/tree": {
      "get": {
        "tags": [
          "v1",
          "files"
        ],
        "summary": "Get Record Tree",
        "description": "Returns record with every record linking to it through a parent link.",
        "operationId": "get_record_tree_api_v1_records__recordId__tree_get",
        "parameters": [
          {
            "name": "recordId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "title": "Recordid"
            }
          },
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Levels below the record. All if None.",
              "title": "Depth"
            },
            "description": "Levels below the record. All if None."
          }
        ],
        "responses": {
          "200": {
            "description": "Record with every record below it. File records carry status and upload metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordTree"
                }
              }
            }
          },
          "404": {
            "description": "No such record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/records/{recordId}/ancestors": {
      "get": {
        "tags": [
          "v1",
          "files"
        ],
        "summary": "Get Record Ancestors",
        "description": "Returns record with its parents, their parents and so on.",
        "operationId": "get_record_ancestors_api_v1_records__recordId__ancestors_get",
        "parameters": [
          {
            "name": "recordId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "title": "Recordid"
            }
          },
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Levels above the record. All if None.",
              "title": "Depth"
            },
            "description": "Levels above the record. All if None."
          }
        ],
        "responses": {
          "200": {
            "description": "Record with its parents up to the top.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordAncestors"
                }
              }
            }
          },
          "404": {
            "description": "No such record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/records/{recordId}/upload-form": {
      "post": {
        "tags": [
          "v1",
          "files"
        ],
        "summary": "Post Upload Form",
        "description": "Returns form to upload the file record's file with (object storage).\n\nRe-upload to replace running or failed upload. Call ``POST /records/{id}/complete`` after completed upload.",
        "operationId": "post_upload_form_api_v1_records__recordId__upload_form_post",
        "parameters": [
          {
            "name": "recordId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "title": "Recordid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FileToUpload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Form to upload the file with.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadForm"
                }
              }
            }
          },
          "404": {
            "description": "No such record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "File is being processed, already ready, or the worker holds it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed, or the record's class carries no file.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/records/{recordId}/complete": {
      "post": {
        "tags": [
          "v1",
          "files"
        ],
        "summary": "Complete Upload",
        "description": "Confirms file upload and queues it for processing.",
        "operationId": "complete_upload_api_v1_records__recordId__complete_post",
        "parameters": [
          {
            "name": "recordId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "title": "Recordid"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "File is queued for processing, or processed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUpload"
                }
              }
            }
          },
          "404": {
            "description": "No such record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Upload not found and file does not match, or import failed, or the file is being processed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed, or the record's class carries no file.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "File storage cannot be reached. Please try again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ontology": {
      "get": {
        "tags": [
          "v1",
          "ontology"
        ],
        "summary": "Get Ontology",
        "description": "Returns loaded ontology with every class and property.",
        "operationId": "get_ontology_api_v1_ontology_get",
        "responses": {
          "200": {
            "description": "Every class of the ontology with its properties and annotations.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OntologyDescription"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EdgeType": {
        "type": "string",
        "enum": [
          "parent",
          "simple"
        ],
        "title": "EdgeType",
        "description": "Kind of link (``og:edgeType``)."
      },
      "FileToUpload": {
        "properties": {
          "size": {
            "type": "integer",
            "maximum": 5368709120.0,
            "minimum": 1.0,
            "title": "Size",
            "description": "Size in bytes."
          }
        },
        "type": "object",
        "required": [
          "size"
        ],
        "title": "FileToUpload",
        "description": "Body of ``POST /records/{id}/upload-form``."
      },
      "FileUpload": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "File record id."
          },
          "status": {
            "$ref": "#/components/schemas/UploadStatus",
            "description": "Where the file is in its life cycle."
          },
          "errorCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errorcode",
            "description": "Why the file failed, else null."
          },
          "sizeBytes": {
            "type": "integer",
            "title": "Sizebytes",
            "description": "Announced size, checked on complete."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat",
            "description": "When the upload form was requested."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Updatedat",
            "description": "Last status change."
