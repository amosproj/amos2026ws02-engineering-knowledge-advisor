{
  "openapi": "3.1.0",
  "info": {
    "title": "Engineering Knowledge Advisor API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Confirm that the API process is running.",
        "operationId": "health_api_health_live_get",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response 200 Health Api Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ping": {
      "post": {
        "tags": [
          "v1"
        ],
        "summary": "Test Ping",
        "description": "Sample ping-pong endpoint with request and response bodies.",
        "operationId": "test_ping_api_v1_ping_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestResponse"
                }
              }
            }
          },
          "422": {
            "description": "Request body validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "URI reference identifying the problem type.",
            "default": "about:blank"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title",
            "description": "Short, human-readable summary of the problem type."
          },
          "status": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 599.0,
                "minimum": 100.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Status",
            "description": "HTTP status code generated by the origin server."
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail",
            "description": "Human-readable explanation specific to this occurence."
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance",
            "description": "URI reference identifying this specific occurence"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "title": "Problem",
        "description": "RFC 9457 Problem object"
      },
      "TestRequest": {
        "properties": {
          "ping": {
            "type": "integer",
            "title": "Ping"
          }
        },
        "type": "object",
        "required": [
          "ping"
        ],
        "title": "TestRequest"
      },
      "TestResponse": {
        "properties": {
          "pong": {
            "type": "integer",
            "title": "Pong"
          }
        },
        "type": "object",
        "required": [
          "pong"
        ],
        "title": "TestResponse"
      }
    }
  }
}