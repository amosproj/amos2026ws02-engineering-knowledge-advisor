<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_cad_upload_user_flow" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.33.0">
  <bpmn:documentation>Big picture of how an end user views and manages machines (create, edit, delete), adds a CAD (STEP) file to a machine, and adds or edits knowledge, independent of screens and controls (based on the EKA Main User Flow board, sections A to C). The system side is one collapsed pool; see cad-import.bpmn and records-api.bpmn for what the web app, API, storage and worker do.</bpmn:documentation>
  <bpmn:collaboration id="Collab_cad_upload_user_flow">
    <bpmn:participant id="P_user" name="Viewing and managing machines" processRef="Proc_user" />
    <bpmn:participant id="P_system" name="Engineering Knowledge Advisor" />
    <bpmn:participant id="P_knowledge" name="Adding and editing knowledge" processRef="Proc_knowledge" />
    <bpmn:messageFlow id="M01" name="Machine records and previews" sourceRef="P_system" targetRef="U_open" />
    <bpmn:messageFlow id="M02" name="New record" sourceRef="U_machine" targetRef="P_system" />
    <bpmn:messageFlow id="M03" name="CAD file" sourceRef="U_upload" targetRef="P_system" />
    <bpmn:messageFlow id="M04" name="Cancel" sourceRef="U_upload_cancelled" targetRef="P_system" />
    <bpmn:messageFlow id="M05" name="Import status" sourceRef="P_system" targetRef="U_status" />
    <bpmn:messageFlow id="M06" name="3D model and tree" sourceRef="P_system" targetRef="U_browse" />
    <bpmn:messageFlow id="M07" name="Details" sourceRef="P_system" targetRef="U_inspect" />
    <bpmn:messageFlow id="M08" name="Record edits" sourceRef="U_edit" targetRef="P_system" />
    <bpmn:messageFlow id="M09" name="Delete record" sourceRef="U_deleted" targetRef="P_system" />
    <bpmn:messageFlow id="M11" name="Details and knowledge" sourceRef="P_system" targetRef="K_open" />
    <bpmn:messageFlow id="M12" name="Knowledge record" sourceRef="K_save" targetRef="P_system" />
    <bpmn:messageFlow id="M13" name="Save result or error" sourceRef="P_system" targetRef="K_result" />
    <bpmn:messageFlow id="M14" name="Delete record" sourceRef="K_deleted" targetRef="P_system" />
    <bpmn:messageFlow id="M10" name="Up axis" sourceRef="U_set_axis" targetRef="P_system" />
    <bpmn:textAnnotation id="N_leave">
      <bpmn:text>Leaving after the upload: stops following the import, but server finishes it.
Leaving during the upload stops the upload.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="N_machine_errors">
      <bpmn:text>Creating, editing or deleting can fail. Error is reported to the user.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="N_knowledge_errors">
      <bpmn:text>Deleting can fail (404, 409, 412). Error is reported to the user.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A_errors_knowledge" sourceRef="N_knowledge_errors" targetRef="K_confirm" />
    <bpmn:association id="A_N_leave" sourceRef="N_leave" targetRef="U_status" />
    <bpmn:association id="A_errors_created" sourceRef="N_machine_errors" targetRef="U_created" />
    <bpmn:association id="A_errors_edited" sourceRef="N_machine_errors" targetRef="U_edited" />
    <bpmn:association id="A_errors_deleted" sourceRef="N_machine_errors" targetRef="U_deleted" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_user" isExecutable="false">
    <bpmn:startEvent id="U_start" name="User wants to view or manage machines">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="U_has_cad" name="CAD file chosen?">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="U_merge">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U_upload" name="Upload CAD file">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U_status_gw" name="Status?">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="U_view">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U_browse" name="Browse tree">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="U_select" name="Select any group (tree node)">
      <bpmn:incoming>F33</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="U_inspect" name="Inspect group details">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="U_done" name="Machine viewed">
      <bpmn:incoming>F21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="U_b_cancel" name="Cancel" attachedToRef="U_upload">
      <bpmn:outgoing>F22</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="U_b_cancel_def">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">user cancels the upload</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="U_start" targetRef="U_open" />
    <bpmn:sequenceFlow id="F02" sourceRef="U_open" targetRef="Activity_096zqlp" />
    <bpmn:sequenceFlow id="F03" name="add or retry CAD file" sourceRef="U_add_cad" targetRef="U_file" />
    <bpmn:sequenceFlow id="F04" name="view existing machine" sourceRef="U_add_cad" targetRef="U_view" />
    <bpmn:sequenceFlow id="F05" name="manage machines" sourceRef="U_add_cad" targetRef="U_manage" />
    <bpmn:sequenceFlow id="F23" name="create" sourceRef="U_manage" targetRef="U_machine" />
    <bpmn:sequenceFlow id="F25" name="delete" sourceRef="U_manage" targetRef="U_confirm" />
    <bpmn:sequenceFlow id="F26" sourceRef="U_edit" targetRef="U_edited" />
    <bpmn:sequenceFlow id="F27" sourceRef="U_confirm" targetRef="U_delete_gw" />
    <bpmn:sequenceFlow id="F28" name="yes" sourceRef="U_delete_gw" targetRef="U_deleted" />
    <bpmn:sequenceFlow id="F29" name="no" sourceRef="U_delete_gw" targetRef="U_kept" />
    <bpmn:sequenceFlow id="F06" sourceRef="U_machine" targetRef="U_has_cad" />
    <bpmn:sequenceFlow id="F07" name="yes" sourceRef="U_has_cad" targetRef="U_merge" />
    <bpmn:sequenceFlow id="F08" name="no" sourceRef="U_has_cad" targetRef="U_created" />
    <bpmn:sequenceFlow id="F09" sourceRef="U_file" targetRef="U_merge" />
    <bpmn:sequenceFlow id="F10" sourceRef="U_merge" targetRef="U_upload" />
    <bpmn:sequenceFlow id="F13" sourceRef="U_upload" targetRef="U_status" />
    <bpmn:sequenceFlow id="F22" sourceRef="U_b_cancel" targetRef="U_upload_cancelled" />
    <bpmn:sequenceFlow id="F14" sourceRef="U_status" targetRef="U_status_gw" />
    <bpmn:sequenceFlow id="F15" name="failed" sourceRef="U_status_gw" targetRef="U_failed" />
    <bpmn:sequenceFlow id="F16" name="processing" sourceRef="U_status_gw" targetRef="U_continues" />
    <bpmn:sequenceFlow id="F17" name="ready" sourceRef="U_status_gw" targetRef="U_view" />
    <bpmn:sequenceFlow id="F18" sourceRef="U_view" targetRef="U_browse" />
    <bpmn:sequenceFlow id="F19" sourceRef="U_browse" targetRef="U_axis_q" />
    <bpmn:sequenceFlow id="F20" sourceRef="U_select" targetRef="U_inspect" />
    <bpmn:sequenceFlow id="F21" sourceRef="U_inspect" targetRef="U_done" />
    <bpmn:endEvent id="U_continues" name="Import continues on server">
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="U_machine" name="Create machine">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="F24" name="edit" sourceRef="U_manage" targetRef="U_edit" />
    <bpmn:endEvent id="U_upload_cancelled" name="Import cancelled">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:messageEventDefinition id="U_upload_cancelled_def" />
    </bpmn:endEvent>
    <bpmn:endEvent id="U_failed" name="Import failed">
      <bpmn:incoming>F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="U_status" name="Import status received">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="U_status_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="U_file" name="Choose CAD file">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="U_created" name="Machine created without CAD file">
      <bpmn:incoming>F08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="U_edited" name="Machine edited">
      <bpmn:incoming>F26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="U_kept" name="Deletion cancelled">
      <bpmn:incoming>F29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="U_deleted" name="Machine deleted">
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:messageEventDefinition id="U_deleted_def" />
    </bpmn:endEvent>
    <bpmn:userTask id="U_open" name="Open machine list">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U_delete_gw" name="Delete?">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F28</bpmn:outgoing>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U_confirm" name="Confirm deletion">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U_manage" name="Create, edit or delete?">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
      <bpmn:outgoing>F24</bpmn:outgoing>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_096zqlp" name="Select machine">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>Flow_0bx92v8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0bx92v8" sourceRef="Activity_096zqlp" targetRef="U_add_cad" />
    <bpmn:exclusiveGateway id="U_add_cad" name="Action?">
      <bpmn:incoming>Flow_0bx92v8</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
      <bpmn:outgoing>F04</bpmn:outgoing>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U_edit" name="Edit machine">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U_axis_q" name="3D model upright?">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
      <bpmn:outgoing>F31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="U_axis_m">
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F30" name="yes" sourceRef="U_axis_q" targetRef="U_axis_m" />
    <bpmn:sequenceFlow id="F31" name="no" sourceRef="U_axis_q" targetRef="U_set_axis" />
    <bpmn:sequenceFlow id="F32" sourceRef="U_set_axis" targetRef="U_axis_m" />
    <bpmn:sequenceFlow id="F33" sourceRef="U_axis_m" targetRef="U_select" />
    <bpmn:userTask id="U_set_axis" name="Set up axis of 3D model">
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
  <bpmn:process id="Proc_knowledge" isExecutable="false">
    <bpmn:exclusiveGateway id="K_new" name="New knowledge?">
      <bpmn:incoming>G02</bpmn:incoming>
      <bpmn:outgoing>G03</bpmn:outgoing>
      <bpmn:outgoing>G04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="K_type" name="Choose type and scope">
      <bpmn:incoming>G03</bpmn:incoming>
      <bpmn:outgoing>G05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="K_enter" name="Enter or edit content">
      <bpmn:incoming>Flow_1g2d7la</bpmn:incoming>
      <bpmn:outgoing>G10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="K_saved_gw" name="Saved?">
      <bpmn:incoming>G12</bpmn:incoming>
      <bpmn:outgoing>G13</bpmn:outgoing>
      <bpmn:outgoing>G14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="K_review" name="Review saved knowledge">
      <bpmn:incoming>G13</bpmn:incoming>
      <bpmn:outgoing>G16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="K_done" name="Knowledge saved">
      <bpmn:incoming>G16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="K_start" name="User wants to add or edit knowledge">
      <bpmn:outgoing>G01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="K_save" name="Save knowledge">
      <bpmn:incoming>G10</bpmn:incoming>
      <bpmn:outgoing>G11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="K_merge">
      <bpmn:incoming>G05</bpmn:incoming>
      <bpmn:incoming>G07</bpmn:incoming>
      <bpmn:outgoing>G09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_1g6u3x5">
      <bpmn:incoming>G09</bpmn:incoming>
      <bpmn:incoming>G15</bpmn:incoming>
      <bpmn:outgoing>Flow_1g2d7la</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:boundaryEvent id="K_b_cancel" name="Cancel" attachedToRef="K_enter">
      <bpmn:outgoing>G20</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="K_b_cancel_def">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">user cancels editing</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="G01" sourceRef="K_start" targetRef="K_open" />
    <bpmn:sequenceFlow id="G02" sourceRef="K_open" targetRef="K_new" />
    <bpmn:sequenceFlow id="G03" name="yes" sourceRef="K_new" targetRef="K_type" />
    <bpmn:sequenceFlow id="G04" name="no" sourceRef="K_new" targetRef="K_existing" />
    <bpmn:sequenceFlow id="G05" sourceRef="K_type" targetRef="K_merge" />
    <bpmn:sequenceFlow id="G06" sourceRef="K_existing" targetRef="K_action" />
    <bpmn:sequenceFlow id="G07" name="edit" sourceRef="K_action" targetRef="K_merge" />
    <bpmn:sequenceFlow id="G08" name="delete" sourceRef="K_action" targetRef="K_confirm" />
    <bpmn:sequenceFlow id="Flow_1g2d7la" sourceRef="Gateway_1g6u3x5" targetRef="K_enter" />
    <bpmn:sequenceFlow id="G10" sourceRef="K_enter" targetRef="K_save" />
    <bpmn:sequenceFlow id="G11" sourceRef="K_save" targetRef="K_result" />
    <bpmn:sequenceFlow id="G12" sourceRef="K_result" targetRef="K_saved_gw" />
    <bpmn:sequenceFlow id="G13" name="yes" sourceRef="K_saved_gw" targetRef="K_review" />
    <bpmn:sequenceFlow id="G14" name="no" sourceRef="K_saved_gw" targetRef="K_fix" />
    <bpmn:sequenceFlow id="G16" sourceRef="K_review" targetRef="K_done" />
    <bpmn:sequenceFlow id="G15" sourceRef="K_fix" targetRef="Gateway_1g6u3x5" />
    <bpmn:sequenceFlow id="G09" sourceRef="K_merge" targetRef="Gateway_1g6u3x5" />
    <bpmn:sequenceFlow id="G20" sourceRef="K_b_cancel" targetRef="K_cancelled" />
    <bpmn:userTask id="K_fix" name="Fix or reconcile draft">
      <bpmn:incoming>G14</bpmn:incoming>
      <bpmn:outgoing>G15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="K_cancelled" name="Editing cancelled">
      <bpmn:incoming>G20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="G17" sourceRef="K_confirm" targetRef="K_delete_gw" />
    <bpmn:sequenceFlow id="G18" name="yes" sourceRef="K_delete_gw" targetRef="K_deleted" />
    <bpmn:sequenceFlow id="G19" name="no" sourceRef="K_delete_gw" targetRef="K_kept" />
    <bpmn:endEvent id="K_deleted" name="Knowledge deleted">
      <bpmn:incoming>G18</bpmn:incoming>
      <bpmn:messageEventDefinition id="K_deleted_def" />
    </bpmn:endEvent>
    <bpmn:endEvent id="K_kept" name="Deletion cancelled">
      <bpmn:incoming>G19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="K_confirm" name="Confirm deletion">
      <bpmn:incoming>G08</bpmn:incoming>
      <bpmn:outgoing>G17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="K_delete_gw" name="Delete?">
      <bpmn:incoming>G17</bpmn:incoming>
      <bpmn:outgoing>G18</bpmn:outgoing>
      <bpmn:outgoing>G19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="K_action" name="Edit or delete?">
      <bpmn:incoming>G06</bpmn:incoming>
      <bpmn:outgoing>G07</bpmn:outgoing>
      <bpmn:outgoing>G08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="K_existing" name="Open existing knowledge">
      <bpmn:incoming>G04</bpmn:incoming>
      <bpmn:outgoing>G06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="K_result" name="Save result received">
      <bpmn:incoming>G11</bpmn:incoming>
      <bpmn:outgoing>G12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="K_result_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="K_open" name="Open machine, group or instance">
      <bpmn:incoming>G01</bpmn:incoming>
      <bpmn:outgoing>G02</bpmn:outgoing>
    </bpmn:userTask>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_cad_upload_user_flow">
    <bpmndi:BPMNPlane id="Plane_cad_upload_user_flow" bpmnElement="Collab_cad_upload_user_flow">
      <bpmndi:BPMNShape id="P_user_di" bpmnElement="P_user" isHorizontal="true">
        <dc:Bounds x="160" y="40" width="3350" height="840" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U_start_di" bpmnElement="U_start">
        <dc:Bounds x="242" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="199" y="304" width="121" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U_has_cad_di" bpmnElement="U_has_cad" isMarkerVisible="true">
        <dc:Bounds x="1335" y="415" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1316" y="471" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U_merge_di" bpmnElement="U_merge" isMarkerVisible="true">
        <dc:Bounds x="1655" y="255" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U_upload_di" bpmnElement="U_upload">
        <dc:Bounds x="1800" y="240" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="U_status_gw_di" bpmnElement="U_status_gw" isMarkerVisible="true">
