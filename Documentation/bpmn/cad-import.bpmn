<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_cad_import" targetNamespace="https://github.com/amosproj/amos2026ws02-engineering-knowledge-advisor" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.33.0">
  <bpmn:documentation>Current CAD import (2026-11-17): the web app registers the CadFile record, uploads the CAD file straight to S3 and follows its status; the CAD file worker checks the file, converts it in a child process, stores its GLB and a preview image and imports the assembly tree into records; a cleanup removes abandoned uploads.</bpmn:documentation>
  <bpmn:error id="Err_storage" name="Storage failed" />
  <bpmn:error id="Err_processing" name="Processing failed" />
  <bpmn:collaboration id="Collab_cad_import">
    <bpmn:participant id="P_engineer" name="Creator" />
    <bpmn:participant id="P_web" name="Web app" processRef="Proc_web" />
    <bpmn:participant id="P_api" name="Records API" />
    <bpmn:participant id="P_s3" name="Object storage (S3)" />
    <bpmn:participant id="P_worker" name="CAD file worker: processing" processRef="Proc_worker" />
    <bpmn:participant id="P_cleanup" name="CAD file worker: cleanup" processRef="Proc_cleanup" />
    <bpmn:messageFlow id="M01" name="CAD file" sourceRef="P_engineer" targetRef="W_start" />
    <bpmn:messageFlow id="M02" name="Cancel" sourceRef="P_engineer" targetRef="W_b_cancel" />
    <bpmn:messageFlow id="M26" name="Cancel" sourceRef="P_engineer" targetRef="W_b_cancel_form" />
    <bpmn:messageFlow id="M03" name="Error message" sourceRef="W_dialog" targetRef="P_engineer" />
    <bpmn:messageFlow id="M04" name="Still-processing notice" sourceRef="W_slow" targetRef="P_engineer" />
    <bpmn:messageFlow id="M05" name="Ready notice" sourceRef="W_ready" targetRef="P_engineer" />
    <bpmn:messageFlow id="M06" name="Error message" sourceRef="W_error" targetRef="P_engineer" />
    <bpmn:messageFlow id="M27" name="Error message" sourceRef="W_delerror" targetRef="P_engineer" />
    <bpmn:messageFlow id="M28" name="200, or 404 / 409 / 422" sourceRef="P_api" targetRef="W_update" />
    <bpmn:messageFlow id="M29" name="200, or 404 / 409" sourceRef="P_api" targetRef="W_delfile" />
    <bpmn:messageFlow id="M07" name="PATCH name, timestamp" sourceRef="W_update" targetRef="P_api" />
    <bpmn:messageFlow id="M09" name="POST CadFile record" sourceRef="W_create" targetRef="P_api" />
    <bpmn:messageFlow id="M10" name="201+id, or 409 / 422" sourceRef="P_api" targetRef="W_create" />
    <bpmn:messageFlow id="M11" name="POST upload-form {size}" sourceRef="W_form" targetRef="P_api" />
    <bpmn:messageFlow id="M12" name="Signed form" sourceRef="P_api" targetRef="W_form" />
    <bpmn:messageFlow id="M13" name="Signed POST: fields, then file" sourceRef="W_upload" targetRef="P_s3" />
    <bpmn:messageFlow id="M14" name="2xx, or error" sourceRef="P_s3" targetRef="W_upload" />
    <bpmn:messageFlow id="M15" name="DELETE file record" sourceRef="W_delfile" targetRef="P_api" />
    <bpmn:messageFlow id="M16" name="POST complete" sourceRef="W_complete" targetRef="P_api" />
    <bpmn:messageFlow id="M17" name="Upload status" sourceRef="P_api" targetRef="W_complete" />
    <bpmn:messageFlow id="M18" name="GET include=status,upload" sourceRef="W_poll" targetRef="P_api" />
    <bpmn:messageFlow id="M19" name="Status and upload" sourceRef="P_api" targetRef="W_poll" />
    <bpmn:messageFlow id="M20" name="Read object" sourceRef="K_read" targetRef="P_s3" />
    <bpmn:messageFlow id="M21" name="File chunks" sourceRef="P_s3" targetRef="K_read" />
    <bpmn:messageFlow id="M22" name="Delete folder" sourceRef="K_delfolder" targetRef="P_s3" />
    <bpmn:messageFlow id="M25" name="Upload GLB (gzip)" sourceRef="K_store" targetRef="P_s3" />
    <bpmn:messageFlow id="M23" name="Delete folder" sourceRef="C_expire" targetRef="P_s3" />
    <bpmn:messageFlow id="M24" name="Delete orphan objects" sourceRef="C_orphans" targetRef="P_s3" />
    <bpmn:messageFlow id="M30" name="Upload preview (PNG)" sourceRef="K_preview" targetRef="P_s3" />
    <bpmn:textAnnotation id="A_shared_state">
      <bpmn:text>The Records API sets the upload to processing on complete (uploads table). The worker picks it up from there.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A_page_left">
      <bpmn:text>Leaving after the upload: stops following the import, but server finishes it.
Leaving during the upload stops the upload.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A_codes">
      <bpmn:text>Error codes:
- invalid_step_file
- processing_timeout
- parse_error
- import_error</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="As_codes" sourceRef="A_codes" targetRef="K_end_failed" />
    <bpmn:textAnnotation id="A_complete_tries">
      <bpmn:text>Up to 3 tries if busy (409), offline or 5xx</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="As_complete_tries" sourceRef="A_complete_tries" targetRef="W_complete" />
    <bpmn:textAnnotation id="A_poll_interval">
      <bpmn:text>Every 2s while processing.
Skipped if already ready or failed.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="As_poll_interval" sourceRef="A_poll_interval" targetRef="W_poll" />
    <bpmn:association id="As_shared_state" sourceRef="A_shared_state" targetRef="K_start" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_web" isExecutable="false">
    <bpmn:startEvent id="W_start" name="CAD file chosen for a machine record">
      <bpmn:outgoing>F01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="W_start_def" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="W_running" name="Machine already uploading?">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F40</bpmn:outgoing>
      <bpmn:outgoing>F41</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="W_prior" name="Earlier CAD file?">
      <bpmn:incoming>F40</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="W_form" name="Request upload form">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="W_formok" name="Form received?">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="W_upload" name="Upload file to object storage">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="W_uploaded" name="Uploaded?">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="W_complete" name="Complete upload">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics id="W_complete_loop" loopMaximum="3" />
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="W_accepted" name="Upload accepted?">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="W_poll" name="Poll upload status">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics id="W_poll_loop" testBefore="true">
        <bpmn:loopCondition xsi:type="bpmn:tFormalExpression">upload is still processing</bpmn:loopCondition>
      </bpmn:standardLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:sendTask id="W_slow" name="Show still-processing notice">
      <bpmn:incoming>Flow_00qa8f2</bpmn:incoming>
      <bpmn:outgoing>F34</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="W_status" name="Upload status?">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="W_ready" name="Show ready notice">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="W_e2">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="W_e3">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="W_e4">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="W_error" name="Show error">
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="W_failed" name="Import failed">
      <bpmn:incoming>F30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="W_continues" name="Import continues on server">
      <bpmn:incoming>F34</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="W_end_ready" name="File record ready">
      <bpmn:incoming>F25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="W_start" targetRef="W_running" />
    <bpmn:sequenceFlow id="F40" name="no" sourceRef="W_running" targetRef="W_prior" />
    <bpmn:sequenceFlow id="F41" name="yes" sourceRef="W_running" targetRef="W_m_dialog" />
    <bpmn:sequenceFlow id="F42" sourceRef="W_m_dialog" targetRef="W_dialog" />
    <bpmn:sequenceFlow id="F02" name="none" sourceRef="W_prior" targetRef="W_create" />
    <bpmn:sequenceFlow id="F03" name="failed, interrupted or no upload" sourceRef="W_prior" targetRef="W_update" />
    <bpmn:sequenceFlow id="F07" sourceRef="W_create" targetRef="W_m2" />
    <bpmn:sequenceFlow id="F08" name="yes" sourceRef="W_created" targetRef="W_form" />
    <bpmn:sequenceFlow id="F09" name="no" sourceRef="W_created" targetRef="W_m_dialog" />
    <bpmn:sequenceFlow id="F11" sourceRef="W_update" targetRef="W_m2" />
    <bpmn:sequenceFlow id="F12" sourceRef="W_m2" targetRef="W_created" />
    <bpmn:sequenceFlow id="F13" sourceRef="W_form" targetRef="W_formok" />
    <bpmn:sequenceFlow id="F14" name="yes" sourceRef="W_formok" targetRef="W_upload" />
    <bpmn:sequenceFlow id="F15" name="no" sourceRef="W_formok" targetRef="W_e2" />
    <bpmn:sequenceFlow id="F16" sourceRef="W_upload" targetRef="W_uploaded" />
    <bpmn:sequenceFlow id="F17" name="yes" sourceRef="W_uploaded" targetRef="W_complete" />
    <bpmn:sequenceFlow id="F18" name="no" sourceRef="W_uploaded" targetRef="W_e2" />
    <bpmn:sequenceFlow id="F19" sourceRef="W_complete" targetRef="W_accepted" />
    <bpmn:sequenceFlow id="F20" name="yes" sourceRef="W_accepted" targetRef="W_poll" />
    <bpmn:sequenceFlow id="F21" name="no" sourceRef="W_accepted" targetRef="W_e3" />
    <bpmn:sequenceFlow id="F22" sourceRef="W_poll" targetRef="W_status" />
    <bpmn:sequenceFlow id="F34" sourceRef="W_slow" targetRef="W_continues" />
    <bpmn:sequenceFlow id="F23" name="ready" sourceRef="W_status" targetRef="W_ready" />
    <bpmn:sequenceFlow id="F24" name="failed or deleted" sourceRef="W_status" targetRef="W_e4" />
    <bpmn:sequenceFlow id="F25" sourceRef="W_ready" targetRef="W_end_ready" />
    <bpmn:sequenceFlow id="F27" sourceRef="W_e2" targetRef="W_e3" />
    <bpmn:sequenceFlow id="F28" sourceRef="W_e3" targetRef="W_e4" />
    <bpmn:sequenceFlow id="F29" sourceRef="W_e4" targetRef="W_error" />
    <bpmn:sequenceFlow id="F30" sourceRef="W_error" targetRef="W_failed" />
    <bpmn:sequenceFlow id="F32" sourceRef="W_delfile" targetRef="W_deleted" />
    <bpmn:sequenceFlow id="F37" name="yes" sourceRef="W_deleted" targetRef="W_cancelled" />
    <bpmn:sequenceFlow id="F38" name="no" sourceRef="W_deleted" targetRef="W_delerror" />
    <bpmn:sequenceFlow id="F39" sourceRef="W_delerror" targetRef="W_kept" />
    <bpmn:sequenceFlow id="F31" sourceRef="W_b_cancel" targetRef="W_m_cancel" />
    <bpmn:sequenceFlow id="F35" sourceRef="W_b_cancel_form" targetRef="W_m_cancel" />
    <bpmn:sequenceFlow id="F36" sourceRef="W_m_cancel" targetRef="W_delfile" />
    <bpmn:sequenceFlow id="F10" sourceRef="W_dialog" targetRef="W_rejected" />
    <bpmn:boundaryEvent id="W_b_cancel_form" name="Cancel requested" attachedToRef="W_form">
      <bpmn:outgoing>F35</bpmn:outgoing>
      <bpmn:messageEventDefinition id="W_b_cancel_form_def" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="W_b_cancel" name="Cancel requested" attachedToRef="W_upload">
      <bpmn:outgoing>F31</bpmn:outgoing>
      <bpmn:messageEventDefinition id="W_b_cancel_def" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="W_create" name="Create file record">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="W_b_timeout" name="15 min passed" attachedToRef="W_poll">
      <bpmn:outgoing>Flow_00qa8f2</bpmn:outgoing>
      <bpmn:timerEventDefinition id="W_b_timeout_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_00qa8f2" sourceRef="W_b_timeout" targetRef="W_slow" />
    <bpmn:serviceTask id="W_update" name="Update file record">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="W_cancelled" name="Import cancelled">
      <bpmn:incoming>F37</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="W_kept" name="Cancelled, file record kept">
      <bpmn:incoming>F39</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="W_rejected" name="Import not started">
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="W_deleted" name="File record deleted?">
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:outgoing>F37</bpmn:outgoing>
      <bpmn:outgoing>F38</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="W_delfile" name="Delete file record">
      <bpmn:incoming>F36</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="W_m_cancel">
      <bpmn:incoming>F35</bpmn:incoming>
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:outgoing>F36</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="W_m_dialog">
      <bpmn:incoming>F41</bpmn:incoming>
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F42</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="W_created" name="File record registered?">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="W_m2">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="W_delerror" name="Show error">
      <bpmn:incoming>F38</bpmn:incoming>
      <bpmn:outgoing>F39</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="W_dialog" name="Show error">
      <bpmn:incoming>F42</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:sendTask>
  </bpmn:process>
  <bpmn:process id="Proc_worker" isExecutable="false">
    <bpmn:sequenceFlow id="G14" sourceRef="K_b_convert" targetRef="K_e2" />
    <bpmn:sequenceFlow id="G22" sourceRef="K_e2" targetRef="K_e3" />
    <bpmn:sequenceFlow id="G16" name="no" sourceRef="K_parsed" targetRef="K_e3" />
    <bpmn:sequenceFlow id="G23" sourceRef="K_e3" targetRef="K_e4" />
    <bpmn:sequenceFlow id="G20" name="no" sourceRef="K_imported" targetRef="K_e4" />
    <bpmn:sequenceFlow id="G06" name="no" sourceRef="K_result" targetRef="K_missing" />
    <bpmn:sequenceFlow id="G29" name="yes" sourceRef="K_result" targetRef="K_valid" />
    <bpmn:sequenceFlow id="G05" name="no" sourceRef="K_valid" targetRef="K_e2" />
    <bpmn:sequenceFlow id="G04" name="yes" sourceRef="K_valid" targetRef="K_convert" />
    <bpmn:sequenceFlow id="G11" sourceRef="K_b_timeout" targetRef="K_end_timeout" />
    <bpmn:sequenceFlow id="G03" sourceRef="K_read" targetRef="K_result" />
    <bpmn:sequenceFlow id="G10" sourceRef="K_missing" targetRef="K_end_missing" />
    <bpmn:startEvent id="K_start" name="Upload waiting in processing">
      <bpmn:outgoing>G01</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="K_start_def">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">an upload is in processing</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="K_lock" name="Lock oldest waiting upload">
      <bpmn:incoming>G01</bpmn:incoming>
      <bpmn:outgoing>G02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="K_read" name="Read and check STEP file">
      <bpmn:incoming>G02</bpmn:incoming>
      <bpmn:outgoing>G03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="G01" sourceRef="K_start" targetRef="K_lock" />
    <bpmn:sequenceFlow id="G02" sourceRef="K_lock" targetRef="K_read" />
    <bpmn:sequenceFlow id="G24" sourceRef="K_e4" targetRef="K_failed" />
    <bpmn:sequenceFlow id="G08" sourceRef="K_failed" targetRef="K_delfolder" />
    <bpmn:sequenceFlow id="G09" sourceRef="K_delfolder" targetRef="K_end_failed" />
    <bpmn:sequenceFlow id="G13" sourceRef="K_convert" targetRef="K_parsed" />
    <bpmn:sequenceFlow id="G15" name="yes" sourceRef="K_parsed" targetRef="K_glb" />
    <bpmn:sequenceFlow id="G17" sourceRef="K_store" targetRef="K_m_glb" />
    <bpmn:sequenceFlow id="G25" name="yes" sourceRef="K_glb" targetRef="K_store" />
    <bpmn:sequenceFlow id="G26" name="no" sourceRef="K_glb" targetRef="K_m_preview" />
    <bpmn:sequenceFlow id="G27" sourceRef="K_b_store" targetRef="K_m_glb" />
    <bpmn:sequenceFlow id="G28" sourceRef="K_m_glb" targetRef="K_preview" />
    <bpmn:sequenceFlow id="G18" sourceRef="K_import" targetRef="K_imported" />
    <bpmn:sequenceFlow id="G19" name="yes" sourceRef="K_imported" targetRef="K_ready" />
    <bpmn:sequenceFlow id="G07" sourceRef="K_ready" targetRef="K_end_ready" />
    <bpmn:serviceTask id="K_convert" name="Parse STEP file and write its GLB">
      <bpmn:incoming>G04</bpmn:incoming>
      <bpmn:outgoing>G13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="K_e4">
      <bpmn:incoming>G20</bpmn:incoming>
      <bpmn:incoming>G23</bpmn:incoming>
      <bpmn:outgoing>G24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="K_imported" name="Imported?">
      <bpmn:incoming>G18</bpmn:incoming>
      <bpmn:outgoing>G19</bpmn:outgoing>
      <bpmn:outgoing>G20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="K_delfolder" name="Delete file folder">
      <bpmn:incoming>G08</bpmn:incoming>
      <bpmn:outgoing>G09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="K_failed" name="Mark upload failed with its error code">
      <bpmn:incoming>G24</bpmn:incoming>
      <bpmn:outgoing>G08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="K_ready" name="Mark upload ready">
      <bpmn:incoming>G19</bpmn:incoming>
      <bpmn:outgoing>G07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="K_parsed" name="Parsed?">
      <bpmn:incoming>G13</bpmn:incoming>
      <bpmn:outgoing>G15</bpmn:outgoing>
      <bpmn:outgoing>G16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="K_e3">
      <bpmn:incoming>G16</bpmn:incoming>
      <bpmn:incoming>G22</bpmn:incoming>
      <bpmn:outgoing>G23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="K_import" name="Import assembly tree into records">
      <bpmn:incoming>G36</bpmn:incoming>
      <bpmn:outgoing>G18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="K_store" name="Store GLB">
      <bpmn:incoming>G25</bpmn:incoming>
      <bpmn:outgoing>G17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="K_glb" name="GLB written?">
      <bpmn:incoming>G15</bpmn:incoming>
      <bpmn:outgoing>G25</bpmn:outgoing>
      <bpmn:outgoing>G26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="K_m_glb">
      <bpmn:incoming>G17</bpmn:incoming>
      <bpmn:incoming>G27</bpmn:incoming>
      <bpmn:outgoing>G28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:boundaryEvent id="K_b_store" name="Storage failed" attachedToRef="K_store">
      <bpmn:outgoing>G27</bpmn:outgoing>
      <bpmn:errorEventDefinition id="K_b_store_def" errorRef="Err_storage" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="K_end_missing" name="Upload failed: file missing">
      <bpmn:incoming>G10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="K_end_failed" name="Upload failed">
      <bpmn:incoming>G09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="K_end_ready" name="Upload ready">
      <bpmn:incoming>G07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="K_missing" name="Mark upload failed: upload_not_found">
      <bpmn:incoming>G06</bpmn:incoming>
      <bpmn:outgoing>G10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="K_e2">
      <bpmn:incoming>G14</bpmn:incoming>
      <bpmn:incoming>G05</bpmn:incoming>
      <bpmn:outgoing>G22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:boundaryEvent id="K_b_convert" name="30 min passed" attachedToRef="K_convert">
      <bpmn:outgoing>G14</bpmn:outgoing>
      <bpmn:timerEventDefinition id="K_b_convert_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="K_b_timeout" name="30 min passed" attachedToRef="K_read">
      <bpmn:outgoing>G11</bpmn:outgoing>
      <bpmn:timerEventDefinition id="K_b_timeout_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="K_end_timeout" name="Read timed out">
      <bpmn:incoming>G11</bpmn:incoming>
      <bpmn:errorEventDefinition id="K_end_timeout_def" errorRef="Err_processing" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="K_result" name="File found?">
      <bpmn:incoming>G03</bpmn:incoming>
      <bpmn:outgoing>G29</bpmn:outgoing>
      <bpmn:outgoing>G06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="K_valid" name="Valid STEP file?">
      <bpmn:incoming>G29</bpmn:incoming>
      <bpmn:outgoing>G04</bpmn:outgoing>
      <bpmn:outgoing>G05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="K_on_error" name="Handle processing error" triggeredByEvent="true">
      <bpmn:startEvent id="K_err_start" name="Processing failed">
        <bpmn:outgoing>G30</bpmn:outgoing>
        <bpmn:errorEventDefinition id="K_err_start_def" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="K_requeue" name="Move upload to back of queue">
        <bpmn:incoming>G38</bpmn:incoming>
        <bpmn:outgoing>G31</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="K_transient" name="Temporary error?">
        <bpmn:incoming>G31</bpmn:incoming>
        <bpmn:outgoing>G32</bpmn:outgoing>
        <bpmn:outgoing>G33</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateCatchEvent id="K_pause" name="30 s passed">
        <bpmn:incoming>G32</bpmn:incoming>
        <bpmn:outgoing>G34</bpmn:outgoing>
        <bpmn:timerEventDefinition id="K_pause_def">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="K_end_requeued" name="Upload requeued">
        <bpmn:incoming>G34</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="K_end_stopped" name="Worker stopped">
        <bpmn:incoming>G33</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="G30" sourceRef="K_err_start" targetRef="K_stop_q" />
      <bpmn:sequenceFlow id="G31" sourceRef="K_requeue" targetRef="K_transient" />
      <bpmn:sequenceFlow id="G32" name="yes" sourceRef="K_transient" targetRef="K_pause" />
      <bpmn:sequenceFlow id="G33" name="no" sourceRef="K_transient" targetRef="K_end_stopped" />
      <bpmn:sequenceFlow id="G34" sourceRef="K_pause" targetRef="K_end_requeued" />
      <bpmn:exclusiveGateway id="K_stop_q" name="Stop requested?">
        <bpmn:incoming>G30</bpmn:incoming>
        <bpmn:outgoing>G38</bpmn:outgoing>
        <bpmn:outgoing>G39</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="K_end_stop" name="Stopped, upload kept in processing">
        <bpmn:incoming>G39</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="G38" name="no" sourceRef="K_stop_q" targetRef="K_requeue" />
      <bpmn:sequenceFlow id="G39" name="yes" sourceRef="K_stop_q" targetRef="K_end_stop" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="K_preview" name="Render and store preview image">
      <bpmn:incoming>G28</bpmn:incoming>
      <bpmn:outgoing>G35</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="K_m_preview">
      <bpmn:incoming>G35</bpmn:incoming>
      <bpmn:incoming>G26</bpmn:incoming>
      <bpmn:incoming>G37</bpmn:incoming>
      <bpmn:outgoing>G36</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="G35" sourceRef="K_preview" targetRef="K_m_preview" />
    <bpmn:sequenceFlow id="G36" sourceRef="K_m_preview" targetRef="K_import" />
    <bpmn:boundaryEvent id="K_b_preview" name="Rendering or storage failed" attachedToRef="K_preview">
      <bpmn:outgoing>G37</bpmn:outgoing>
      <bpmn:errorEventDefinition id="K_b_preview_def" errorRef="Err_storage" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="G37" sourceRef="K_b_preview" targetRef="K_m_preview" />
  </bpmn:process>
  <bpmn:process id="Proc_cleanup" isExecutable="false">
    <bpmn:startEvent id="C_start" name="Cleanup interval reached">
      <bpmn:outgoing>H01</bpmn:outgoing>
      <bpmn:timerEventDefinition id="C_start_def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT1H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="C_started" name="Worker started">
      <bpmn:outgoing>H04</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="C_merge">
      <bpmn:incoming>H01</bpmn:incoming>
      <bpmn:incoming>H04</bpmn:incoming>
      <bpmn:outgoing>H05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="C_expire" name="Expire abandoned upload (over 24h)">
      <bpmn:incoming>H05</bpmn:incoming>
      <bpmn:outgoing>H02</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics id="C_expire_mi" isSequential="true" />
    </bpmn:serviceTask>
    <bpmn:serviceTask id="C_orphans" name="Delete orphan objects">
      <bpmn:incoming>H02</bpmn:incoming>
      <bpmn:outgoing>H03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="C_end" name="Storage cleaned up">
      <bpmn:incoming>H03</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="H01" sourceRef="C_start" targetRef="C_merge" />
    <bpmn:sequenceFlow id="H04" sourceRef="C_started" targetRef="C_merge" />
    <bpmn:sequenceFlow id="H05" sourceRef="C_merge" targetRef="C_expire" />
    <bpmn:sequenceFlow id="H02" sourceRef="C_expire" targetRef="C_orphans" />
    <bpmn:sequenceFlow id="H03" sourceRef="C_orphans" targetRef="C_end" />
  </bpmn:process>
