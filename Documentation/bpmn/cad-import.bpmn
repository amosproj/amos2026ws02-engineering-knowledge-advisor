    <bpmn:boundaryEvent id="K_b_store" name="Storage failed" attachedToRef="K_store">
      <bpmn:outgoing>G27</bpmn:outgoing>
      <bpmn:errorEventDefinition id="K_b_store_def" errorRef="Err_storage" />
    </bpmn:boundaryEvent>
