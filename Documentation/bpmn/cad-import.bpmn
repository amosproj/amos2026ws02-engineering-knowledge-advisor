<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_cad_import" targetNamespace="https://github.com/amosproj/amos2026ws02-engineering-knowledge-advisor" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:documentation>Current CAD import (2026-11-09): the web app registers the CadFile record, uploads the STEP file straight to S3 and follows its status; the CAD file worker checks it; a cleanup removes abandoned uploads. The import of the assembly tree into records is not built yet and not modelled.</bpmn:documentation>
  <bpmn:collaboration id="Collab_cad_import">
    <bpmn:participant id="P_engineer" name="Creator" />
    <bpmn:participant id="P_web" name="Web app" processRef="Proc_web" />
    <bpmn:participant id="P_api" name="Records API" />
    <bpmn:participant id="P_s3" name="Object storage (S3)" />
    <bpmn:participant id="P_worker" name="CAD file worker: processing" processRef="Proc_worker" />
    <bpmn:participant id="P_cleanup" name="CAD file worker: cleanup" processRef="Proc_cleanup" />
    <bpmn:messageFlow id="M01" name="STEP file" sourceRef="P_engineer" targetRef="W_start" />
    <bpmn:messageFlow id="M02" name="Cancel" sourceRef="P_engineer" targetRef="W_b_cancel" />
    <bpmn:messageFlow id="M03" name="Error message" sourceRef="W_dialog" targetRef="P_engineer" />
    <bpmn:messageFlow id="M04" name="Still-processing notice" sourceRef="W_slow" targetRef="P_engineer" />
    <bpmn:messageFlow id="M05" name="Ready notice" sourceRef="W_ready" targetRef="P_engineer" />
    <bpmn:messageFlow id="M06" name="Error notice" sourceRef="W_error" targetRef="P_engineer" />
    <bpmn:messageFlow id="M07" name="PATCH name, timestamp" sourceRef="W_update" targetRef="P_api" />
    <bpmn:messageFlow id="M08" name="DELETE old record" sourceRef="W_delold" targetRef="P_api" />
    <bpmn:messageFlow id="M09" name="POST CadFile record" sourceRef="W_create" targetRef="P_api" />
    <bpmn:messageFlow id="M10" name="201 id, or 409 / 422" sourceRef="P_api" targetRef="W_create" />
    <bpmn:messageFlow id="M11" name="POST upload-form {size}" sourceRef="W_form" targetRef="P_api" />
    <bpmn:messageFlow id="M12" name="Signed form" sourceRef="P_api" targetRef="W_form" />
    <bpmn:messageFlow id="M13" name="Signed POST: fields, then file" sourceRef="W_upload" targetRef="P_s3" />
    <bpmn:messageFlow id="M14" name="204, or 403" sourceRef="P_s3" targetRef="W_upload" />
    <bpmn:messageFlow id="M15" name="DELETE file record" sourceRef="W_delfile" targetRef="P_api" />
    <bpmn:messageFlow id="M16" name="POST complete" sourceRef="W_complete" targetRef="P_api" />
    <bpmn:messageFlow id="M17" name="Upload state" sourceRef="P_api" targetRef="W_complete" />
    <bpmn:messageFlow id="M18" name="GET include=status,upload" sourceRef="W_poll" targetRef="P_api" />
    <bpmn:messageFlow id="M19" name="Status and upload" sourceRef="P_api" targetRef="W_poll" />
    <bpmn:messageFlow id="M20" name="Read object" sourceRef="K_read" targetRef="P_s3" />
    <bpmn:messageFlow id="M21" name="File chunks" sourceRef="P_s3" targetRef="K_read" />
    <bpmn:messageFlow id="M22" name="Delete folder" sourceRef="K_delfolder" targetRef="P_s3" />
    <bpmn:messageFlow id="M23" name="Delete folder" sourceRef="C_expire" targetRef="P_s3" />
    <bpmn:messageFlow id="M24" name="Delete orphan objects" sourceRef="C_orphans" targetRef="P_s3" />
    <bpmn:textAnnotation id="A_shared_state">
      <bpmn:text>The Records API sets the upload to processing on complete (Postgres, cad_uploads). The worker picks it up from there.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A_page_left">
      <bpmn:text>Leaving the page only stops following the import. The server finishes it.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="As_shared_state" sourceRef="A_shared_state" targetRef="K_start" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_web" isExecutable="false">
    <bpmn:startEvent id="W_start" name="STEP file chosen for a machine">
      <bpmn:outgoing>F01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="W_start_def" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="W_prior" name="Earlier CAD file?">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
      <bpmn:outgoing>F03</bpmn:outgoing>
      <bpmn:outgoing>F04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="W_delold" name="Delete old file record">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="W_m1">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="W_create" name="Create file record">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="W_created" name="Record created?">
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="W_m2">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="W_form" name="Request upload form">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="W_formok" name="Form received?">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="W_upload" name="Upload file to object storage">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="W_uploaded" name="Uploaded?">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="W_complete" name="Complete upload (up to 3 tries while busy)">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics id="W_complete_loop" />
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="W_accepted" name="Upload accepted?">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="W_poll" name="Poll upload status every 2 s">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
      <bpmn:standardLoopCharacteristics id="W_poll_loop" />
    </bpmn:serviceTask>
    <bpmn:sendTask id="W_slow" name="Show still-processing notice">
      <bpmn:incoming>F33</bpmn:incoming>
      <bpmn:outgoing>F34</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="W_status" name="Upload status?">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="W_ready" name="Show ready notice">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="W_e1">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="W_e2">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="W_e3">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="W_e4">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="W_error" name="Show error notice">
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="W_failed" name="Import failed">
      <bpmn:incoming>F30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="W_continues" name="Import continues on server">
      <bpmn:incoming>F34</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="W_end_ready" name="CAD file ready">
      <bpmn:incoming>F25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="W_cancelled" name="Import cancelled">
      <bpmn:incoming>F32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="W_delfile" name="Delete file record">
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="W_update" name="Update file record details">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="W_rejected" name="File record rejected">
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="W_dialog" name="Show error in dialog">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:boundaryEvent id="W_b_timeout" name="15 min passed" attachedToRef="W_poll">
      <bpmn:outgoing>F33</bpmn:outgoing>
      <bpmn:timerEventDefinition id="W_b_timeout_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="W_b_cancel" name="Cancel requested" attachedToRef="W_upload">
      <bpmn:outgoing>F31</bpmn:outgoing>
      <bpmn:messageEventDefinition id="W_b_cancel_def" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="W_start" targetRef="W_prior" />
    <bpmn:sequenceFlow id="F02" name="none" sourceRef="W_prior" targetRef="W_m1" />
    <bpmn:sequenceFlow id="F03" name="upload interrupted" sourceRef="W_prior" targetRef="W_update" />
    <bpmn:sequenceFlow id="F04" name="ready file to replace" sourceRef="W_prior" targetRef="W_delold" />
    <bpmn:sequenceFlow id="F05" sourceRef="W_delold" targetRef="W_m1" />
    <bpmn:sequenceFlow id="F06" sourceRef="W_m1" targetRef="W_create" />
    <bpmn:sequenceFlow id="F07" sourceRef="W_create" targetRef="W_created" />
    <bpmn:sequenceFlow id="F08" name="yes" sourceRef="W_created" targetRef="W_m2" />
    <bpmn:sequenceFlow id="F09" name="no (409 or 422)" sourceRef="W_created" targetRef="W_dialog" />
    <bpmn:sequenceFlow id="F11" sourceRef="W_update" targetRef="W_m2" />
    <bpmn:sequenceFlow id="F12" sourceRef="W_m2" targetRef="W_form" />
    <bpmn:sequenceFlow id="F13" sourceRef="W_form" targetRef="W_formok" />
    <bpmn:sequenceFlow id="F14" name="yes" sourceRef="W_formok" targetRef="W_upload" />
    <bpmn:sequenceFlow id="F15" name="no" sourceRef="W_formok" targetRef="W_e1" />
    <bpmn:sequenceFlow id="F16" sourceRef="W_upload" targetRef="W_uploaded" />
    <bpmn:sequenceFlow id="F17" name="yes" sourceRef="W_uploaded" targetRef="W_complete" />
    <bpmn:sequenceFlow id="F18" name="no" sourceRef="W_uploaded" targetRef="W_e2" />
    <bpmn:sequenceFlow id="F19" sourceRef="W_complete" targetRef="W_accepted" />
    <bpmn:sequenceFlow id="F20" name="yes" sourceRef="W_accepted" targetRef="W_poll" />
    <bpmn:sequenceFlow id="F21" name="no" sourceRef="W_accepted" targetRef="W_e3" />
    <bpmn:sequenceFlow id="F22" sourceRef="W_poll" targetRef="W_status" />
    <bpmn:sequenceFlow id="F33" sourceRef="W_b_timeout" targetRef="W_slow" />
    <bpmn:sequenceFlow id="F34" sourceRef="W_slow" targetRef="W_continues" />
    <bpmn:sequenceFlow id="F23" name="ready" sourceRef="W_status" targetRef="W_ready" />
    <bpmn:sequenceFlow id="F24" name="failed or removed" sourceRef="W_status" targetRef="W_e4" />
    <bpmn:sequenceFlow id="F25" sourceRef="W_ready" targetRef="W_end_ready" />
    <bpmn:sequenceFlow id="F26" sourceRef="W_e1" targetRef="W_e2" />
    <bpmn:sequenceFlow id="F27" sourceRef="W_e2" targetRef="W_e3" />
    <bpmn:sequenceFlow id="F28" sourceRef="W_e3" targetRef="W_e4" />
    <bpmn:sequenceFlow id="F29" sourceRef="W_e4" targetRef="W_error" />
    <bpmn:sequenceFlow id="F30" sourceRef="W_error" targetRef="W_failed" />
    <bpmn:sequenceFlow id="F32" sourceRef="W_delfile" targetRef="W_cancelled" />
    <bpmn:sequenceFlow id="F31" sourceRef="W_b_cancel" targetRef="W_delfile" />
    <bpmn:sequenceFlow id="F10" sourceRef="W_dialog" targetRef="W_rejected" />
  </bpmn:process>
  <bpmn:process id="Proc_worker" isExecutable="false">
    <bpmn:startEvent id="K_start" name="Upload waiting in processing">
      <bpmn:outgoing>G01</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="K_start_def">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">an upload is in processing</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="K_lock" name="Lock oldest waiting upload">
      <bpmn:incoming>G01</bpmn:incoming>
      <bpmn:outgoing>G02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="K_read" name="Read and check STEP file">
      <bpmn:incoming>G02</bpmn:incoming>
      <bpmn:outgoing>G03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="K_result" name="Check result?">
      <bpmn:incoming>G03</bpmn:incoming>
      <bpmn:outgoing>G04</bpmn:outgoing>
      <bpmn:outgoing>G05</bpmn:outgoing>
      <bpmn:outgoing>G06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="K_ready" name="Mark upload ready">
      <bpmn:incoming>G04</bpmn:incoming>
      <bpmn:outgoing>G07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="K_invalid" name="Mark upload failed: invalid_step_file">
      <bpmn:incoming>G05</bpmn:incoming>
      <bpmn:outgoing>G08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="K_delfolder" name="Delete file folder">
      <bpmn:incoming>G08</bpmn:incoming>
      <bpmn:outgoing>G09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="K_end_invalid" name="Upload failed: invalid STEP file">
      <bpmn:incoming>G09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="K_missing" name="Mark upload failed: upload_not_found">
      <bpmn:incoming>G06</bpmn:incoming>
      <bpmn:outgoing>G10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="K_requeue" name="Move upload to back of queue">
      <bpmn:incoming>G11</bpmn:incoming>
      <bpmn:outgoing>G12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="K_end_ready" name="Upload ready">
      <bpmn:incoming>G07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="K_end_missing" name="Upload failed: file missing">
      <bpmn:incoming>G10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="K_end_requeued" name="Upload requeued">
      <bpmn:incoming>G12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="K_b_timeout" name="30 min passed" attachedToRef="K_read">
      <bpmn:outgoing>G11</bpmn:outgoing>
      <bpmn:timerEventDefinition id="K_b_timeout_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="G01" sourceRef="K_start" targetRef="K_lock" />
    <bpmn:sequenceFlow id="G02" sourceRef="K_lock" targetRef="K_read" />
    <bpmn:sequenceFlow id="G03" sourceRef="K_read" targetRef="K_result" />
    <bpmn:sequenceFlow id="G04" name="valid" sourceRef="K_result" targetRef="K_ready" />
    <bpmn:sequenceFlow id="G05" name="invalid STEP file" sourceRef="K_result" targetRef="K_invalid" />
    <bpmn:sequenceFlow id="G06" name="file missing" sourceRef="K_result" targetRef="K_missing" />
    <bpmn:sequenceFlow id="G07" sourceRef="K_ready" targetRef="K_end_ready" />
    <bpmn:sequenceFlow id="G08" sourceRef="K_invalid" targetRef="K_delfolder" />
    <bpmn:sequenceFlow id="G09" sourceRef="K_delfolder" targetRef="K_end_invalid" />
    <bpmn:sequenceFlow id="G10" sourceRef="K_missing" targetRef="K_end_missing" />
    <bpmn:sequenceFlow id="G11" sourceRef="K_b_timeout" targetRef="K_requeue" />
    <bpmn:sequenceFlow id="G12" sourceRef="K_requeue" targetRef="K_end_requeued" />
  </bpmn:process>
  <bpmn:process id="Proc_cleanup" isExecutable="false">
    <bpmn:startEvent id="C_start" name="Cleanup interval reached">
      <bpmn:outgoing>H01</bpmn:outgoing>
      <bpmn:timerEventDefinition id="C_start_def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">between processing runs</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="C_expire" name="Expire abandoned upload (uploading over 24 h)">
      <bpmn:incoming>H01</bpmn:incoming>
      <bpmn:outgoing>H02</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics id="C_expire_mi" isSequential="true" />
    </bpmn:serviceTask>
    <bpmn:serviceTask id="C_orphans" name="Delete orphan objects">
      <bpmn:incoming>H02</bpmn:incoming>
      <bpmn:outgoing>H03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="C_end" name="Storage cleaned up">
      <bpmn:incoming>H03</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="H01" sourceRef="C_start" targetRef="C_expire" />
    <bpmn:sequenceFlow id="H02" sourceRef="C_expire" targetRef="C_orphans" />
    <bpmn:sequenceFlow id="H03" sourceRef="C_orphans" targetRef="C_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_cad_import">
    <bpmndi:BPMNPlane id="Plane_cad_import" bpmnElement="Collab_cad_import">
      <bpmndi:BPMNShape id="P_web_di" bpmnElement="P_web" isHorizontal="true">
        <dc:Bounds x="160" y="230" width="3260" height="590" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W_start_di" bpmnElement="W_start">
        <dc:Bounds x="292" y="602" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="268" y="638" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W_prior_di" bpmnElement="W_prior" isMarkerVisible="true">
        <dc:Bounds x="445" y="595" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="379" y="583" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W_delold_di" bpmnElement="W_delold">
        <dc:Bounds x="570" y="700" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W_m1_di" bpmnElement="W_m1" isMarkerVisible="true">
        <dc:Bounds x="765" y="595" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W_create_di" bpmnElement="W_create">
        <dc:Bounds x="890" y="580" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="W_created_di" bpmnElement="W_created" isMarkerVisible="true">
