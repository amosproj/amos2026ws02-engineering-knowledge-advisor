# PostgreSQL
POSTGRES_DB=engineering_knowledge
POSTGRES_USER=eka_app
POSTGRES_PASSWORD=change_me_to_a_long_random_password

# MinIO / S3-compatible storage
MINIO_ROOT_USER=eka_minio_admin
MINIO_ROOT_PASSWORD=change_me_to_another_long_random_password
S3_BUCKET=engineering-documents
S3_REGION=us-east-1


# this .env applies to backend only if it's run from repo root with:
#   uv run --project apps/api uvicorn main:app

API_PROFILE=dev
API_DATABASE_URL=postgresql+psycopg://eka_app:change_me_to_a_long_random_password@db:5432/engineering_knowledge

API_OGRAG_ONTOLOGY_PATH=ontology_v0.jsonld

API_S3_ENDPOINT_URL=http://localhost:9000
API_S3_BUCKET=engineering-documents
API_S3_ACCESS_KEY=eka_minio_admin
API_S3_SECRET_KEY=change_me_to_another_long_random_password
API_S3_REGION=us-east-1
API_S3_PUBLIC_URL=/storage


# Frontend mode: dev (Vite hot reload) or prod (Nginx build)
WEB_PROFILE=dev

# Local only: also expose Postgres (5432) and MinIO (9000 API, 9001 console) on localhost
COMPOSE_FILE=compose.yaml:compose.local.yaml

# Frontend (public: VITE_* values are bundled into the browser JS, never put secrets here)
# Base URL of the API: leave empty to use the same-origin /api proxy (recommended)
VITE_API_URL=

# Frontend dev server only: where Vite proxies /api during `npm run dev`
WEB_API_PROXY_TARGET=http://localhost:8000
